/*
	CRT_Factory.rc — Windows resource script.

	The PiPL is generated from ../resources/FreeCRT_PiPL.r by a pre-build step
	(see CRT_Factory.vcxproj and docs/build.md) into FreeCRT_PiPL.rrc, which is
	included below. If you build by hand, generate the .rrc first.
*/

#include <windows.h>

/* Generated PiPL resource (produced by PiPLtool). */
#include "FreeCRT_PiPL.rrc"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION		0,1,0,1
	PRODUCTVERSION	0,1,0,1
	FILEFLAGSMASK	0x3fL
	FILEFLAGS		0x0L
	FILEOS			VOS_NT_WINDOWS32
	FILETYPE		VFT_DLL
	FILESUBTYPE		0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",		"Open re-implementation"
			VALUE "FileDescription",	"Free CRT effect for After Effects"
			VALUE "FileVersion",		"0.1.0.1"
			VALUE "InternalName",		"CRT_Factory"
			VALUE "OriginalFilename",	"CRT_Factory.aex"
			VALUE "ProductName",		"Free CRT"
			VALUE "ProductVersion",		"0.1.0.1"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
